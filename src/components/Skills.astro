---
const skills = [
  {
    category: 'Programming Languages',
    items: ['Python', 'SQL', 'Bash', 'HCL', 'YAML'],
  },
  {
    category: 'Cloud Platforms & Services',
    items: ['GCP — BigQuery · GCS · Cloud Run · Cloud Functions · Cloud SQL · Artifact Registry', 'AWS', 'Snowflake'],
  },
  {
    category: 'Infrastructure & IaC',
    items: ['Terraform', 'Docker', 'Kaniko', 'Podman', 'Kubernetes', 'Helm'],
  },
  {
    category: 'CI/CD & DevOps',
    items: ['GitLab CI/CD', 'GitHub Actions', 'GitLab Components', 'Pipeline Templating', 'Container Scanning'],
  },
  {
    category: 'Data Orchestration & Transformation',
    items: ['Dagster', 'Apache Airflow (Cloud Composer / Astronomer)', 'dbt', 'Dataform'],
  },
  {
    category: 'Pipeline Patterns',
    items: ['ETL / ELT', 'Pipeline Architecture', 'Data Modelling', 'Data Contracts', 'APIs'],
  },
  {
    category: 'Security & Identity',
    items: ['Workload Identity Federation', 'IAM', 'Container Scanning', 'Secret Management'],
  },
  {
    category: 'Developer Tooling',
    items: ['Git', 'Linux', 'Pre-commit', 'uv', 'Grafana', 'Obsidian'],
  },
];
---

<section id="skills" class="border-t border-border-subtle">
  <div class="max-w-3xl mx-auto px-6 md:px-14 pt-12 pb-16">
    <p class="font-mono text-xs text-muted tracking-widest uppercase mb-10">Skills & Stack</p>

    <div class="flex flex-col gap-6">
      {skills.map(group => (
        <div class="grid grid-cols-1 md:grid-cols-[160px_1fr] gap-2 md:gap-6 items-start pb-4 md:pb-0 border-b border-border-subtle md:border-none">
          <span class="font-mono text-xs text-muted pt-1">{group.category}</span>
          <div class="flex flex-wrap gap-2">
            {group.items.map(item => (
              <span class="font-mono text-xs text-secondary border border-border
                          px-2 py-0.5 bg-surface-raised hover:text-accent
                          hover:border-accent transition-colors">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
